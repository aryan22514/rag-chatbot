# Copy to .env and add your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional — free-tier keys have small per-model daily limits (e.g. 20/day).
# When the main model is rate limited, the app retries on the fallbacks in order.
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# SUGGESTION_MODEL=gemini-3.5-flash-lite
